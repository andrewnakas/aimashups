---
import '../styles/global.css';
import { SITE, GA_ID, abs } from '../lib/site';
import { breadcrumbs, type Crumb } from '../lib/schema';

interface Props {
  title: string; // page title without the site name
  description: string;
  crumbs?: Crumb[];
  jsonld?: object[];
  image?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], jsonld = [], image = '/og/default.png', noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);
const fullTitle = Astro.url.pathname === '/' ? `${SITE.name}: ${title}` : `${title} | ${SITE.name}`;
const ld = crumbs.length ? [breadcrumbs([{ name: 'Home', path: '/' }, ...crumbs]), ...jsonld] : jsonld;
const nav = [
  ['/latest/', 'Latest'],
  ['/play/', 'Play'],
  ['/history/', 'History'],
  ['/mashups/', 'Mashups'],
  ['/games/', 'Games'],
  ['/guides/', 'Guides'],
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved theme before first paint so the page never flashes the wrong one.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1014" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: latest`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <slot name="head" />
    {GA_ID && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ gaId: GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          // Automated browsers (CI, smoke tests) are kept out of the data.
          if (!navigator.webdriver) gtag('config', gaId);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">AIGame<span>Mashups</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-tools">
          <a class="icon-btn" href="/search/" aria-label="Search"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch colour theme">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main class="wrap" data-pagefind-body>
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => <> › {i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.path}>{c.name}</a>}</>)}
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/about/clean-room/">Clean-room policy</a>
          <a href="/techniques/">Techniques</a>
          <a href="/search/">Search</a>
          <a href={SITE.repo}>GitHub</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p>
          AI Game Mashups is an independent fan and documentation project. It isn't affiliated with or endorsed by any
          game publisher or developer mentioned here. Game names are trademarks of their owners and are used only to
          describe and document. Playable games on this site are clean-room originals: no game files, decompiled code or
          retail assets.
        </p>
        <p>Sister sites: <a href="https://decompgames.com">Decomp Games</a> · <a href="https://skatemods.com">Skate Mods</a></p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
