---
import Base from '../../layouts/Base.astro';
import MashupCard from '../../components/MashupCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { article } from '../../lib/schema';

export async function getStaticPaths() {
  return (await getCollection('techniques')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'techniques'> };
const { Content } = await render(entry);
const mashups = (await getCollection('mashups')).filter((m) => m.data.technique.id === entry.id);
const path = `/techniques/${entry.id}/`;
---
<Base title={`${entry.data.name}: How AI Game Mashups Work`} description={entry.data.summary}
  crumbs={[{ name: 'Techniques', path: '/techniques/' }, { name: entry.data.name, path }]}
  jsonld={[article({ headline: entry.data.name, description: entry.data.summary, path, published: new Date('2026-10-06') })]}>
  <h1>{entry.data.name}</h1>
  <p class="lede">{entry.data.summary}</p>
  <article class="prose"><Content /></article>
  {mashups.length > 0 && (
    <section class="section"><h2>Mashups built this way</h2><ul class="grid">{mashups.map((e) => <li><MashupCard entry={e} /></li>)}</ul></section>
  )}
</Base>
