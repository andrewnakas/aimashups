---
import Base from '../../layouts/Base.astro';
import MashupCard from '../../components/MashupCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { article, faqPage } from '../../lib/schema';

export async function getStaticPaths() {
  return (await getCollection('techniques')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'techniques'> };
const { Content } = await render(entry);
const mashups = (await getCollection('mashups')).filter((m) => m.data.technique.id === entry.id);
const path = `/techniques/${entry.id}/`;
const d = entry.data;
---
<Base title={`${d.name}: How AI Game Mashups Work`} seoTitle={d.seoTitle} description={d.description ?? d.summary}
  crumbs={[{ name: 'Techniques', path: '/techniques/' }, { name: d.name, path }]}
  jsonld={[article({ headline: d.name, description: d.summary, path, published: new Date('2026-10-06') }), ...(d.faqs.length ? [faqPage(d.faqs)] : [])]}>
  <h1>{d.name}</h1>
  <p class="lede">{d.summary}</p>
  <article class="prose">
    <Content />
    {d.faqs.length > 0 && (<><h2>FAQ</h2><dl class="faq">{d.faqs.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl></>)}
  </article>
  {mashups.length > 0 && (
    <section class="section"><h2>Mashups built this way</h2><ul class="grid">{mashups.map((e) => <li><MashupCard entry={e} /></li>)}</ul></section>
  )}
</Base>
