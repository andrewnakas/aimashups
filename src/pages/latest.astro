---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import { feed } from '../lib/feed';
import { fmtDate } from '../lib/site';
const items = await feed();
const month = items[0].date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`Latest AI Game Mashups & News (${month})`} description={`New AI game mashups, viral clips, tools, press and install guides, newest first: ${items.length} dated, sourced entries, most recently on ${fmtDate(items[0].date)}.`} crumbs={[{ name: 'Latest', path: '/latest/' }]}>
  <h1>Latest</h1>
  <p class="lede">The newest entry here is <a href={items[0].href}>{items[0].title}</a>, from {fmtDate(items[0].date)}. Below is every new mashup, clip, crossover, tool, news story and guide, newest first. Follow along with the <a href="/rss.xml">RSS feed</a>.</p>
  <Feed items={items} />
</Base>
