---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { article } from '../../lib/schema';
import { fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('guides')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'guides'> };
const { Content } = await render(entry);
const path = `/guides/${entry.id}/`;
const d = entry.data;
const mashup = d.mashup ? await getEntry(d.mashup) : undefined;
---
<Base title={entry.data.title} description={entry.data.summary} image={`/og/guides/${entry.id}.png`} crumbs={[{ name: 'Guides', path: '/guides/' }, { name: entry.data.title, path }]}
  jsonld={[article({ headline: entry.data.title, description: entry.data.summary, path, published: d.date, modified: d.updated })]}>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <p class="small muted">{fmtDate(d.date)}{d.updated && <> · updated {fmtDate(d.updated)}</>}{d.difficulty && <> · {d.difficulty}</>}{d.time && <> · about {d.time}</>}{mashup && <> · for <a href={`/mashups/${mashup.id}/`}>{mashup.data.title}</a></>}</p>
  <article class="prose"><Content /></article>
</Base>
