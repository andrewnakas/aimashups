---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { article } from '../../lib/schema';
import { fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('guides')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'guides'> };
const { Content } = await render(entry);
const path = `/guides/${entry.id}/`;
---
<Base title={entry.data.title} description={entry.data.summary} crumbs={[{ name: 'Guides', path: '/guides/' }, { name: entry.data.title, path }]}
  jsonld={[article({ headline: entry.data.title, description: entry.data.summary, path, published: entry.data.date })]}>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <p class="small muted">{fmtDate(entry.data.date)}</p>
  <article class="prose"><Content /></article>
</Base>
