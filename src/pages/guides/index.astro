---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const list = (await getCollection('guides')).sort((a, b) => +(b.data.updated ?? b.data.date) - +(a.data.updated ?? a.data.date));
const play = list.filter((g) => g.data.mashup);
const other = list.filter((g) => !g.data.mashup);
const meta = (g: (typeof list)[number]) => [g.data.difficulty, g.data.time && `about ${g.data.time}`].filter(Boolean).join(' · ');
---
<Base title={`How to Install & Play ${play.length} Game Mashups`} description={`Step-by-step install guides for ${play.length} game mashups, from SkyCraft to ER Mario: the game versions, mod loaders and files each one needs, and how to start it.`} crumbs={[{ name: 'Guides', path: '/guides/' }]}>
  <h1>Guides</h1>
  <p class="lede">Each guide shows how to install and play one downloadable game mashup: which game versions and mod loaders it needs, where to get the release, and how to start it. There are {play.length}, built from each project's own README and release notes, plus how to make your own. New to mashups? Read <a href="/guides/start-here-playing-game-mashups/">what every mashup needs</a> first.</p>
  {[['How to play', play], ['Make your own and get started', other]].map(([label, gs]) => (gs as typeof list).length > 0 && (
    <section class="section">
      <h2>{label as string}</h2>
      <ul class="grid">{(gs as typeof list).map((g) => <li><a class="card" href={`/guides/${g.id}/`}><h3>{g.data.title}</h3><p>{g.data.summary}</p>{meta(g) && <p class="small">{meta(g)}</p>}</a></li>)}</ul>
    </section>
  ))}
</Base>
