---
import Base from '../../layouts/Base.astro';
import PresetCard from '../../components/PresetCard.astro';
import MashupCard from '../../components/MashupCard.astro';
import Comments from '../../components/Comments.astro';
import OriginBadge from '../../components/OriginBadge.astro';
import { getCollection, getEntry, getEntries, render, type CollectionEntry } from 'astro:content';
import { ALL_PRESETS, presetSlug } from '../../data/presets';
import { fmtDate } from '../../lib/site';
import { article, faqPage } from '../../lib/schema';
import { lineage } from '../../lib/history';

export async function getStaticPaths() {
  return (await getCollection('mashups')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'mashups'> };
const d = entry.data;
const { Content } = await render(entry);
const games = await getEntries(d.games);
const technique = await getEntry(d.technique);
const tribute = d.tribute ? ALL_PRESETS.find((p) => presetSlug(p) === d.tribute) : undefined;
if (d.tribute && !tribute) throw new Error(`${entry.id}: unknown tribute ${d.tribute}`);
const gameIds = d.games.map((g) => g.id);
const related = (await getCollection('mashups')).filter((m) => m.id !== entry.id && m.data.games.some((g) => gameIds.includes(g.id))).slice(0, 3);
const path = `/mashups/${entry.id}/`;
// Lineage, timeline mentions, and neighbours in time.
const guide = (await getCollection('guides')).find((g) => g.data.mashup?.id === entry.id);
const tree = await lineage();
const builtOn = tree.parentsOf(entry.id);
const ledTo = tree.children(entry.id);
const mentions = (await getCollection('events')).filter((e) => e.data.mashup?.id === entry.id).sort((a, b) => +a.data.date - +b.data.date);
const chrono = (await getCollection('mashups')).sort((a, b) => +a.data.date - +b.data.date || a.id.localeCompare(b.id));
const at = chrono.findIndex((m) => m.id === entry.id);
const [prev, next] = [chrono[at - 1], chrono[at + 1]];
const statusText = {
  'downloadable': 'Downloadable',
  'source-only': 'Source only (build it yourself)',
  'video-only': 'Video only, no code released',
  'unreleased': 'Announced, not released',
}[d.status];
---
<Base title={d.title} description={d.summary} image={`/og/mashups/${entry.id}.png`}
  crumbs={[{ name: 'Mashups', path: '/mashups/' }, { name: d.title, path }]}
  jsonld={[article({ headline: d.title, description: d.summary, path, published: d.checked, about: games.map((g) => g.data.name) }), ...(d.faqs.length ? [faqPage(d.faqs)] : [])]}>
  <h1>{d.title}</h1>
  <p class="lede">{d.summary}</p>
  <div class="layout-2">
    <article class="prose">
      {guide && <p class="howto"><strong>How to try it</strong><a href={`/guides/${guide.id}/`}>{guide.data.title}</a>{guide.data.time && <span class="muted"> · about {guide.data.time}</span>}</p>}
      <Content />
      {(builtOn.length > 0 || ledTo.length > 0) && (<>
        <h2>Lineage</h2>
        {builtOn.length > 0 && <p><strong>Built on:</strong> {builtOn.map((n, i) => <>{i > 0 && ', '}<a href={n.url}>{n.name}</a></>)}.</p>}
        {ledTo.length > 0 && <p><strong>Led to:</strong> {ledTo.map((n, i) => <>{i > 0 && ', '}<a href={n.url}>{n.name}</a></>)}.</p>}
        <p class="small muted">See the whole <a href="/history/#family">family tree</a>.</p>
      </>)}
      {mentions.length > 0 && (<>
        <h2>In the timeline</h2>
        <ul>{mentions.map((e) => <li><a href={`/history/#t-${e.id}`}>{fmtDate(e.data.date)}: {e.data.title}</a>. {e.data.text}</li>)}</ul>
      </>)}
      {d.faqs.length > 0 && (<><h2>FAQ</h2><dl class="faq">{d.faqs.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl></>)}
      {d.sources.length > 0 && (<>
        <h2>Sources</h2>
        <ul class="small">{d.sources.map((s) => <li><a href={s.url} rel="nofollow">{s.title}</a>{s.publisher && <span class="muted"> ({s.publisher})</span>}</li>)}</ul>
      </>)}
    </article>
    <aside>
      <dl class="facts">
        <dt>Status</dt><dd><span class={`status ${d.status}`}>{statusText}</span></dd>
        <dt>Made by</dt><dd><OriginBadge origin={d.origin} /></dd>
        <dt>Games</dt><dd>{games.map((g, i) => <>{i > 0 && ', '}<a href={`/games/${g.id}/`}>{g.data.name}</a></>)}</dd>
        <dt>Creator</dt><dd>{d.creators.map((c, i) => <>{i > 0 && ', '}{c.url ? <a href={c.url}>{c.name}</a> : c.name}</>)}</dd>
        <dt>Technique</dt><dd><a href={`/techniques/${technique.id}/`}>{technique.data.name}</a></dd>
        <dt>First seen</dt><dd>{fmtDate(d.date)}</dd>
        {d.repo && <><dt>Repo</dt><dd><a href={d.repo}>{d.repo.replace('https://github.com/', '')}</a></dd></>}
        {d.license && <><dt>License</dt><dd>{d.license}</dd></>}
        {d.stars !== undefined && <><dt>Stars</dt><dd>{d.stars.toLocaleString('en-US')}</dd></>}
        {d.downloads !== undefined && <><dt>Downloads</dt><dd>{d.downloads.toLocaleString('en-US')}</dd></>}
        {d.reach && <><dt>Reach</dt><dd>{d.reach}</dd></>}
        <dt>Own copies</dt><dd>{d.needsOwnCopy ? 'Required' : 'Not needed'}</dd>
        <dt>Checked</dt><dd>{fmtDate(d.checked)}</dd>
      </dl>
      {d.builtOn.length > 0 && (<><h3>Built on</h3><ul class="small">{d.builtOn.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul></>)}
      {d.seenOn.length > 0 && (<><h3>Spotted via</h3><ul class="small">{d.seenOn.map((l) => <li><a href={l.url} rel="nofollow">{l.label}</a></li>)}</ul></>)}
      {d.links.length > 0 && (<><h3>Links</h3><ul class="small">{d.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul></>)}
      {tribute && (<>
        <h3>Play something like it now</h3>
        <p class="small muted">A clean-room tribute that runs in your browser, no game files needed.</p>
        <PresetCard preset={tribute} />
      </>)}
    </aside>
  </div>
  {related.length > 0 && (
    <section class="section">
      <h2>Related mashups</h2>
      <ul class="grid">{related.map((e) => <li><MashupCard entry={e} /></li>)}</ul>
    </section>
  )}
  <nav class="section prevnext" aria-label="Previous and next in the history">
    {prev ? <a href={`/mashups/${prev.id}/`}>← {fmtDate(prev.data.date)}: {prev.data.title}</a> : <span />}
    <a href={`/history/#t-${entry.id}`}>On the timeline</a>
    {next ? <a href={`/mashups/${next.id}/`}>{fmtDate(next.data.date)}: {next.data.title} →</a> : <span />}
  </nav>
  <p class="small muted section">Something wrong or out of date? <a href={`https://github.com/andrewnakas/aimashups/edit/main/src/content/mashups/${entry.id}.md`}>Edit this page on GitHub</a>.</p>
  <Comments />
</Base>
