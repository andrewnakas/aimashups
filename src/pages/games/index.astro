---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const games = await getCollection('games');
const mashups = await getCollection('mashups');
const count = (id: string) => mashups.filter((m) => m.data.games.some((g) => g.id === id)).length;
const sorted = games.sort((a, b) => count(b.id) - count(a.id) || a.data.name.localeCompare(b.data.name));
const used = sorted.filter((g) => count(g.id) > 0).length;
const [g1, g2, g3] = sorted;
---
<Base title={`${used} Games in AI Game Mashups, From Minecraft to GTA V`} description={`All ${used} games in AI game mashups. ${g1.data.name} is in ${count(g1.id)}, ${g2.data.name} in ${count(g2.id)}, ${g3.data.name} in ${count(g3.id)}. See every mashup for each game.`} crumbs={[{ name: 'Games', path: '/games/' }]}>
  <h1>Games in AI mashups</h1>
  <p class="lede">{used} games have ended up in the {mashups.length} mashups tracked here. {g1.data.name} appears in {count(g1.id)}, more than any other game, then {g2.data.name} with {count(g2.id)} and {g3.data.name} with {count(g3.id)}. Pick a game to see every mashup that uses it.</p>
  <ul class="grid">{sorted.map((g) => (
    <li><a class="card" href={`/games/${g.id}/`}><h3>{g.data.name}</h3><p>{g.data.summary}</p><p class="small">{count(g.id)} mashup{count(g.id) === 1 ? '' : 's'}</p></a></li>
  ))}</ul>
</Base>
