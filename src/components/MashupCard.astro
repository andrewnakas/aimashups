---
import type { CollectionEntry } from 'astro:content';
import OriginBadge from './OriginBadge.astro';
import { fmtDate, isoDate } from '../lib/site';
interface Props { entry: CollectionEntry<'mashups'>; }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="card" href={`/mashups/${entry.id}/`}
  data-origin={d.origin} data-status={d.status} data-technique={d.technique.id}
  data-games={d.games.map((g) => g.id).join(' ')} data-date={isoDate(d.date)} data-stars={d.stars ?? 0}>
  <div class="badges"><span class={`status ${d.status}`}>{d.status.replace('-', ' ')}</span><OriginBadge origin={d.origin} /></div>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
  <p class="small">{d.creators.map((c) => c.name).join(', ')} · {fmtDate(d.date)}</p>
</a>
