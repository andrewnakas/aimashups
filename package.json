{
  "name": "aimashups",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist && node scripts/postbuild.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && node scripts/validate.mjs",
    "validate": "node scripts/validate.mjs",
    "deploy": "wrangler deploy --assets dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2",
    "satori": "^0.47.1",
    "typescript": "^6.0.3"
  }
}
